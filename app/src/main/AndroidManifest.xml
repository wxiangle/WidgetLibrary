        </activity>
        <activity
            android:name=".activity.BottomGapViewTestActivity"
            android:exported="true">

        </activity>
        <activity android:name=".activity.CardViewTestActivity" />
        <activity android:name=".activity.ExpandTextTestActivity" />
        <activity android:name=".activity.ShadowViewTestActivity" />
        <activity android:name=".activity.FrescoActivity" />
        <activity android:name=".activity.GlideActivity" />
